// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  position     String?
  telegram     String?
  role         String   @default("MANAGER")
  status       String   @default("ACTIVE")
  // Заполняется телеграм-ботом при привязке, пользователь его не вводит.
  telegramChatId String?
  // JSON-строка с личными настройками (каналы уведомлений и т.п.).
  // SQLite не умеет Json, поэтому храним текстом.
  prefs        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  counterparties         Counterparty[] @relation("CounterpartyCreatedBy")
  counterpartiesUpdated  Counterparty[] @relation("CounterpartyUpdatedBy")
  counterpartiesManaged  Counterparty[] @relation("CounterpartyManager")
  projects               Project[]      @relation("ProjectManager")
  projectsCreated        Project[]      @relation("ProjectCreatedBy")
  projectsUpdated        Project[]      @relation("ProjectUpdatedBy")
  dealsAsManager         Deal[]         @relation("DealManager")
  dealsAsAuthor          Deal[]         @relation("DealCreatedBy")
  dealsUpdated           Deal[]         @relation("DealUpdatedBy")
  invites                Invite[]       @relation("InviteCreatedBy")
  tasksAsAssignee        Task[]         @relation("TaskAssignee")
  tasksAsAuthor          Task[]         @relation("TaskCreatedBy")
  shipmentsCreated       Shipment[]     @relation("ShipmentCreatedBy")
  shipmentsUpdated       Shipment[]     @relation("ShipmentUpdatedBy")
  notes                  Note[]         @relation("NoteAuthor")
  attachments            Attachment[]   @relation("AttachmentUploadedBy")
  changeLogs             ChangeLog[]    @relation("ChangeLogAuthor")
  tendersDecided         Tender[]       @relation("TenderDecidedBy")

  @@map("users")
}

model ChangeLog {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String
  parentEntityType String?
  parentEntityId   String?
  action           String
  changes          String?
  authorId         String?
  author           User?    @relation("ChangeLogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([entityType, entityId])
  @@index([parentEntityType, parentEntityId])
  @@index([createdAt])
  @@map("change_logs")
}

model Invite {
  id          String   @id @default(cuid())
  token       String   @unique
  email       String?
  role        String   @default("MANAGER")
  expiresAt   DateTime
  usedAt      DateTime?
  usedByEmail String?
  createdById String
  createdBy   User     @relation("InviteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([token])
  @@map("invites")
}

// Группа компаний: клиент может работать через несколько своих юрлиц
// («договор заключим с другого ООО, это тоже мы»). Каждое юрлицо остаётся
// самостоятельным Counterparty со своими сделками и контактами, группа лишь
// связывает их: общая скидка, суммарный бюджет, поиск по ИНН любого из них.
model CounterpartyGroup {
  id        String         @id @default(cuid())
  name      String
  discount  Decimal?
  note      String?
  members   Counterparty[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("counterparty_groups")
}

model Counterparty {
  id              String   @id @default(cuid())
  type            String
  name            String
  region          String
  city            String?
  inn             String?
  kpp             String?
  ogrn            String?
  okpo            String?
  okved           String?
  bankName        String?
  bankAccount     String?
  bankCorrAccount String?
  bik             String?
  totalRevenue    Decimal  @default(0)
  discount        Decimal?
  phone           String?
  email           String?
  website         String?
  address         String?
  source          String?
  companyKind     String?
  activityArea    String?
  // Только для END_CUSTOMER: важность клиента, 1 (высокий) … 3 (низкий).
  priority        Int?
  note            String?
  contacts        Contact[]
  // Наше собственное юрлицо: продаём мы, а не нам. Карточка остаётся обычным
  // контрагентом (обычно дистрибьютором) — флаг лишь помечает её как «свою»,
  // чтобы подставлять в сделки. Отмечает администратор в /crm/settings,
  // компания по умолчанию хранится в Setting["defaultOwnCompanyId"].
  isOwnCompany    Boolean  @default(false)
  // Группа компаний: одно из юрлиц помечается головным (isGroupPrimary).
  groupId         String?
  group           CounterpartyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isGroupPrimary  Boolean  @default(false)
  managerId       String?
  manager         User?    @relation("CounterpartyManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?    @relation("CounterpartyCreatedBy", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?    @relation("CounterpartyUpdatedBy", fields: [updatedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectsAsDistributor  Project[] @relation("ProjectDistributor")
  projectsAsEndCustomer  Project[] @relation("ProjectEndCustomer")
  deals                  Deal[]    @relation("DealCounterparty")
  dealsAsAuctionCustomer Deal[]    @relation("DealAuctionCustomer")
  dealsAsPayer           Deal[]    @relation("DealPayer")
  tasksAsDistributor     Task[]    @relation("TaskDistributor")
  tasksAsEndCustomer     Task[]    @relation("TaskEndCustomer")

  @@unique([inn, kpp])
  @@index([type])
  @@index([region])
  @@index([groupId])
  @@index([isOwnCompany])
  @@map("counterparties")
}

model Project {
  id                String        @id @default(cuid())
  externalAuctionId String?
  internalName      String
  status            String        @default("IN_PROGRESS")
  totalAmount       Decimal       @default(0)
  // Скидка проекта, %. Наследуется от контрагента (или его группы) при
  // создании и дальше уходит в сделки проекта — см. lib/crm/discount.js.
  discount          Decimal?
  auctionDate       DateTime?
  duplicateComment  String?
  duplicateOfId     String?
  duplicateOf       Project?      @relation("ProjectDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        Project[]     @relation("ProjectDuplicate")
  lossReason        String?
  lossComment       String?

  distributorId     String
  distributor       Counterparty  @relation("ProjectDistributor", fields: [distributorId], references: [id])
  endCustomerId     String
  endCustomer       Counterparty  @relation("ProjectEndCustomer", fields: [endCustomerId], references: [id])
  managerId         String
  manager           User          @relation("ProjectManager", fields: [managerId], references: [id])
  createdById       String?
  createdBy         User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         User?         @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])

  items             ProjectItem[]
  contacts          Contact[]
  tasks             Task[]
  deals             Deal[]        @relation("ProjectDeals")

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([externalAuctionId, endCustomerId])
  @@index([distributorId])
  @@index([endCustomerId])
  @@index([managerId])
  @@map("projects")
}

model ProjectItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku       String?
  name      String
  quantity  Decimal  @default(1)
  amount    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([productId])
  @@map("project_items")
}

model Product {
  id                  String        @id @default(cuid())
  sku                 String        @unique
  name                String
  category            String
  basePrice           Decimal       @default(0)
  packagePrice        Decimal       @default(0)
  recommendedLpuPrice Decimal?
  transportPackQty    Int           @default(0)
  unitWeightKg        Decimal?
  unitVolumeM3        Decimal?
  contents            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  projectItems        ProjectItem[]
  dealItems           DealItem[]    @relation("DealItemProduct")
  stocks              Stock[]

  @@index([category])
  @@map("products")
}

model Stock {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse  String
  quantity   Int      @default(0)
  syncedAt   DateTime @default(now())

  @@unique([productId, warehouse])
  @@index([productId])
  @@map("stocks")
}

model Contact {
  id             String        @id @default(cuid())
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  phone          String?
  workPhone      String?
  email          String?
  birthDate      DateTime?
  position       String?
  comment        String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects       Project[]
  deals          Deal[]    @relation("DealContact")
  dealsAsAuctionCustomerContact Deal[] @relation("DealAuctionCustomerContact")
  shipments      Shipment[] @relation("ShipmentRecipient")

  @@index([counterpartyId])
  @@map("contacts")
}

model Deal {
  id              String   @id @default(cuid())
  title           String?
  status          String   @default("NEGOTIATION")
  totalAmount     Decimal  @default(0)
  discount        Decimal?
  note            String?
  deliveryAddress String?
  lossReason      String?
  lossComment     String?

  // Аукцион (госзакупка): при isAuction=true у сделки появляется вторая
  // сторона — заказчик (конечный потребитель) — и параметры закупки.
  isAuction         Boolean   @default(false)
  purchaseNumber    String?
  auctionUrl        String?
  nmck              Decimal   @default(0)
  bidsDeadlineAt    DateTime?
  auctionAt         DateTime?
  resultsAt         DateTime?
  participantsCount Int?
  bidsCount         Int?
  winner            String?

  counterpartyId String
  counterparty   Counterparty @relation("DealCounterparty", fields: [counterpartyId], references: [id])
  contactId      String?
  contact        Contact?     @relation("DealContact", fields: [contactId], references: [id], onDelete: SetNull)
  // Юрлицо, на которое оформляются договор и счёт. Пусто — плательщик
  // совпадает с клиентом; заполнено — клиент попросил оформить документы
  // на другое юрлицо своей группы.
  payerId        String?
  payer          Counterparty? @relation("DealPayer", fields: [payerId], references: [id], onDelete: SetNull)
  // Заказчик аукциона (конечный потребитель) и его контакт — только при isAuction.
  auctionCustomerId        String?
  auctionCustomer          Counterparty? @relation("DealAuctionCustomer", fields: [auctionCustomerId], references: [id], onDelete: SetNull)
  auctionCustomerContactId String?
  auctionCustomerContact   Contact?      @relation("DealAuctionCustomerContact", fields: [auctionCustomerContactId], references: [id], onDelete: SetNull)
  managerId      String
  manager        User         @relation("DealManager", fields: [managerId], references: [id])
  createdById    String
  createdBy      User         @relation("DealCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?        @relation("DealUpdatedBy", fields: [updatedById], references: [id])
  sourceProjectId String?
  sourceProject   Project?    @relation("ProjectDeals", fields: [sourceProjectId], references: [id], onDelete: SetNull)

  items          DealItem[]
  tasks          Task[]
  shipments      Shipment[]
  // Закупка из Tenderland, из которой завели эту сделку (если завели).
  tender         Tender?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([counterpartyId])
  @@index([managerId])
  @@index([sourceProjectId])
  @@index([isAuction])
  @@index([payerId])
  @@map("deals")
}

model DealItem {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation("DealItemProduct", fields: [productId], references: [id], onDelete: SetNull)
  sku       String?
  name      String
  quantity  Decimal  @default(1)
  amount    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipmentItems ShipmentItem[]

  @@index([dealId])
  @@index([productId])
  @@map("deal_items")
}

model Shipment {
  id                 String   @id @default(cuid())
  number             String   @unique
  dealId             String
  deal               Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  status             String   @default("DRAFT")
  plannedDate        DateTime?
  shippedAt          DateTime?
  deliveryAddress    String?
  carrier            String?
  trackingNumber     String?
  recipientContactId String?
  recipientContact   Contact? @relation("ShipmentRecipient", fields: [recipientContactId], references: [id], onDelete: SetNull)
  recipientName      String?
  recipientPhone     String?
  recipientEmail     String?
  docNumber          String?
  note               String?

  items              ShipmentItem[]

  createdById        String?
  createdBy          User?    @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          User?    @relation("ShipmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([dealId])
  @@index([status])
  @@index([plannedDate])
  @@map("shipments")
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  dealItemId String
  dealItem   DealItem @relation(fields: [dealItemId], references: [id], onDelete: Cascade)
  quantity   Decimal  @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shipmentId])
  @@index([dealItemId])
  @@map("shipment_items")
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  type          String
  status        String    @default("OPEN")
  result        String?
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean   @default(true)

  assigneeId    String
  assignee      User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById   String
  createdBy     User      @relation("TaskCreatedBy", fields: [createdById], references: [id])

  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  distributorId  String?
  distributor    Counterparty? @relation("TaskDistributor", fields: [distributorId], references: [id], onDelete: SetNull)
  endCustomerId  String?
  endCustomer    Counterparty? @relation("TaskEndCustomer", fields: [endCustomerId], references: [id], onDelete: SetNull)

  closedAt      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@index([startAt])
  @@index([dealId])
  @@index([projectId])
  @@index([distributorId])
  @@index([endCustomerId])
  @@map("tasks")
}

// Настройки CRM: простое key-value хранилище (шаблоны писем и т.п.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// Заявка с публичной формы обратной связи на сайте
model Lead {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  company     String?
  message     String?
  source      String    @default("Веб-сайт (форма на сайте)")
  status      String    @default("NEW")
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  // Отметка о согласии на обработку ПД: бремя доказывания согласия лежит на
  // операторе (ч. 3 ст. 9 152-ФЗ), поэтому фиксируем момент и текст, под
  // которым пользователь поставил галочку. У заявок, принятых до появления
  // чекбокса, поля пустые.
  consentAt   DateTime?
  consentText String?
  // Отдельное согласие на рекламные и информационные рассылки (ст. 18 ФЗ
  // «О рекламе»). Необязательное: пустое поле значит, что писать этому
  // человеку можно только по его обращению, но не с новостями и акциями.
  marketingConsentAt   DateTime?
  marketingConsentText String?

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model Neoset {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  pathname    String
  srcImg      String
  code        Code[]
  images      Images[]

  @@map("neosets")
}

model Images {
  id          Int     @id @default(autoincrement())
  alt         String?
  description String?
  src         String
  neoset      Neoset? @relation(fields: [neosetId], references: [id])
  neosetId    Int?
}

model Code {
  id         Int         @id @default(autoincrement())
  neoset     Neoset?     @relation(fields: [neosetId], references: [id])
  neosetId   Int?
  title      String
  transcript String
  consist    Consist[]
  consistOf  ConsistOf[]

  @@map("codes")
}

model Consist {
  id                   Int     @id @default(autoincrement())
  Code                 Code?   @relation(fields: [codeId], references: [id])
  codeId               Int?
  napkin               String?
  ball                 String?
  pintsetMedium        String?
  pintsetThin          String?
  scalpelRemoveFiber   String?
  scalpelEleven        String?
  clamp                String?
  needleHolder         String?
  container            String?
  bandage              String?
  plasterTrip          String?
  plaster              String?
  plasterPostOperative String?
  plasterFixCatheter   String?
  cover                String?
  coverAperture        String?
  coverAdhesive        String?
}

model ConsistOf {
  id        Int    @id @default(autoincrement())
  code      Code?  @relation(fields: [codeId], references: [id])
  codeId    Int?
  component String
  count     String
  class     String

  @@map("consistOf")
}

model Category {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  content String?
  posts   Post[]
}

model Section {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model Post {
  id         String    @id @default(cuid())
  title      String
  content    String
  photoUrl   String?
  postUrl    String?
  categoryId Int?
  sectionId  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category? @relation(fields: [categoryId], references: [id])
  section    Section?  @relation(fields: [sectionId], references: [id])

  @@map("posts")
}

model Note {
  id          String       @id @default(cuid())
  body        String
  entityType  String
  entityId    String
  pinned      Boolean      @default(false)
  authorId    String
  author      User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[] @relation("NoteAttachments")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([entityType, entityId])
  @@index([authorId])
  @@map("notes")
}

model Attachment {
  id            String   @id @default(cuid())
  fileName      String
  mimeType      String
  size          Int
  storageKey    String
  entityType    String?
  entityId      String?
  noteId        String?
  note          Note?    @relation("NoteAttachments", fields: [noteId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([noteId])
  @@index([uploadedById])
  @@map("attachments")
}

// Входящая закупка из Tenderland. Отдельная сущность, а не сразу сделка:
// автопоиск «CRM: воронка закупок» даёт ~15-20 закупок в день, и часть из них
// нам не подходит по составу ТЗ (чужие наборы различимы по КТРУ). Менеджер
// решает «участвуем / мимо», и только «участвуем» рождает сделку.
model Tender {
  id           String    @id @default(cuid())
  // Идентификатор Тендерлэнда (TL\d+) — ключ дедупликации: повторная выгрузка
  // обновляет запись, а не плодит копии.
  tenderlandId String    @unique
  regNumber    String?
  name         String
  beginPrice   Decimal   @default(0)
  publishDate  DateTime?
  beginDate    DateTime?
  // Окончание приёма заявок и дата торгов — уезжают в сделку как
  // bidsDeadlineAt и auctionAt, по ним же строится доска аукционов.
  endDate      DateTime?
  biddingDate  DateTime?
  region       String?
  typeName     String?
  // Статус на площадке, как его отдаёт Тендерлэнд (не статус нашей сделки).
  tenderStatus String?
  sourceLink   String?
  etpName      String?
  // Позиции КТРУ строкой через перевод строки: по ним менеджер за секунду
  // отличает наш набор от чужого (ЛОР, лапароскопия, катетер в комплекте).
  ktru         String?
  // Полное наименование заказчика и краткое. Держим оба: полное доходит до 265
  // символов («НАУЧНО-ИССЛЕДОВАТЕЛЬСКИЙ ИНСТИТУТ … - ФИЛИАЛ ФГБУ …»), в списке
  // такое не читается, а краткое иногда вырождается в «ЦГКБ», по которому
  // заказчика не опознать и не найти поиском. Что показывать — решает список.
  customerName String?
  customerShortName String?
  customerInn  String?
  customerKpp  String?
  customerOgrn String?

  // Победитель приезжает из Тендерлэнда только когда закупка перешла в статус
  // «Закупка завершена»; до этого поля пустые. По ИНН отличаем свою победу от
  // чужой — название своего юрлица в протоколе пишут как угодно.
  winnerInn    String?
  winnerName   String?

  // Дата последнего изменения закупки на стороне Тендерлэнда (Entity/GetEvents).
  // Сравнение с ней решает, нужно ли тратить лимит на добор данных.
  tlUpdatedAt  DateTime?
  // Когда мы в последний раз применили приехавшее изменение — этим подписан
  // значок «обновлено» в списке. Отличается от updatedAt, который меняется и
  // от решения менеджера.
  refreshedAt  DateTime?

  // Откуда закупка взялась: AUTOSEARCH — приехала из автопоиска, MANUAL —
  // заведена вручную по номеру. Точка инкремента синхронизации (searchAfterId)
  // считается только по AUTOSEARCH: ручная закупка со свежим идентификатором
  // сдвинула бы курсор и молча отрезала хвост автопоиска.
  source       String    @default("AUTOSEARCH")

  // NEW — не разобрана, TAKEN — участвуем (заведена сделка), SKIPPED — мимо.
  decision     String    @default("NEW")
  decisionAt   DateTime?
  decisionById String?
  decisionBy   User?     @relation("TenderDecidedBy", fields: [decisionById], references: [id], onDelete: SetNull)
  skipReason   String?

  dealId       String?   @unique
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  importedAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([decision])
  @@index([endDate])
  @@index([customerInn])
  @@map("tenders")
}
